{
  "manifest_version": 3,
  "name": "Mouse Dictionary Positioner",
  "version": "1.0.1",
  "description": "Mouse Dictionaryのポップアップをマウス近くに表示する",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Mouse Dictionary Positioner - 使い方"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
